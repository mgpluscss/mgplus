{
  "name": "mgplus-tokens",
  "version": "2.0.0",
  "color": {
    "primary": {
      "$value": "oklch(55% 0.22 264)",
      "$type": "color",
      "description": "Primary brand accent color"
    },
    "red": {
      "$value": "oklch(60% 0.22 25)",
      "$type": "color",
      "description": "Danger status color"
    },
    "orange": {
      "$value": "oklch(70% 0.18 55)",
      "$type": "color",
      "description": "Warning status color"
    },
    "green": {
      "$value": "oklch(62% 0.18 145)",
      "$type": "color",
      "description": "Success status color"
    },
    "blue": {
      "$value": "oklch(60% 0.2 250)",
      "$type": "color",
      "description": "Info status color"
    },
    "dark": {
      "$value": "oklch(14% 0.015 260)",
      "$type": "color",
      "description": "Base dark background"
    },
    "light": {
      "$value": "oklch(98% 0.005 260)",
      "$type": "color",
      "description": "Base light background"
    }
  },
  "dimension": {
    "radius": {
      "control": {
        "$value": "1rem",
        "$type": "dimension"
      },
      "input": {
        "$value": "1rem",
        "$type": "dimension"
      }
    },
    "spacing": {
      "gutter": {
        "$value": "0.5rem",
        "$type": "dimension"
      }
    }
  },
  "typography": {
    "base": {
      "$value": "1.6rem",
      "$type": "dimension"
    },
    "fontFamily": {
      "sans": {
        "$value": "Roboto, 'Helvetica Neue', Helvetica, Arial, sans-serif",
        "$type": "fontFamily"
      },
      "mono": {
        "$value": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace",
        "$type": "fontFamily"
      }
    }
  },
  "elevation": {
    "control": {
      "$value": "0 0 2px rgb(0 0 0 / 20%), 0 3px 4px rgb(0 0 0 / 15%)",
      "$type": "shadow"
    }
  }
}
